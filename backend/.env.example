# AstraGuard AI — Backend environment variables
# Copy this file to .env and fill in your credentials.

# ── IBM watsonx.ai ───────────────────────────────────────────────────────────
# Generate an API key at: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your-ibm-cloud-api-key-here

# watsonx.ai regional endpoint (us-south is the default)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Project ID from your watsonx.ai project settings
WATSONX_PROJECT_ID=your-project-id-here

# Granite model to use (default: ibm/granite-3-3-8b-instruct)
# Other options: ibm/granite-3-8b-instruct, ibm/granite-13b-instruct-v2
GRANITE_MODEL=ibm/granite-3-3-8b-instruct
